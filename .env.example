# Application Configuration
APP_NAME=ShortX
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
BASE_URL=http://localhost:8000

# Security / JWT
SECRET_KEY=shortx-super-secret-development-key-change-in-production-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL for Docker/Production, SQLite fallback for quick local run)
# PostgreSQL: postgresql://postgres:postgres@localhost:5432/shortx_db
# Docker Compose: postgresql://shortx_user:shortx_password@db:5432/shortx_db
DATABASE_URL=sqlite:///./shortx.db

# Redis (Caching & Rate Limiting)
# Docker Compose: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=86400

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
